# copy to .env and fill in; never commit .env
DB_PASSWORD=change-me
# HS512 signing key, at least 64 characters: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=
# image uploads (profile pictures, ad photos, categories) need a Cloudinary account
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GATEWAY_PORT=8080
# basic auth for the Kibana logs/usage dashboard at http://localhost:8080/kibana/ (user: admin)
KIBANA_PASSWORD=change-me
